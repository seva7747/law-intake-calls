# ---- Copy this file to ".env" and fill in every value ----

# Public https URL of this server (ngrok URL while testing, Render/Railway URL when live).
# No trailing slash. Example: https://abcd-1234.ngrok-free.app
PUBLIC_URL=

# Port the server listens on locally
PORT=3000

# Anthropic (Claude) API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Twilio Auth Token (Twilio Console home page -> "Auth Token"). Used to verify requests really come from Twilio.
TWILIO_AUTH_TOKEN=

# Law office details (used in what the AI says)
FIRM_NAME=the law office of Mr. Tsivyanes
ATTORNEY_NAME=Mr. Tsivyanes
INTAKE_EMAIL=lawclerk@tsivyanesq.com

# Where call summaries get emailed
SUMMARY_TO=lawclerk@tsivyanesq.com

# Email sending (SMTP). Gmail example below; use an "App Password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Password to open the dashboard website (username is always "admin")
DASHBOARD_PASSWORD=

# Voice. ttsProvider: Google or ElevenLabs. Voice examples: Google "en-US-Journey-O" / "en-US-Journey-F"
TTS_PROVIDER=Google
TTS_VOICE=en-US-Journey-O
